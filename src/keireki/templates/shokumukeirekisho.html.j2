<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>職務経歴書</title>
  <link rel="stylesheet" href="{{ style_path }}">
</head>
<body class="document shokumukeirekisho">
  <header class="shokumu-header">
    <h1>職務経歴書</h1>
    <div>
      <p>{{ profile.document.generated_at | era }} 現在</p>
      <p>{{ profile.person.name.kanji }}</p>
      {% if profile.preferences.headline or profile.preferences.tagline %}
      <dl class="profile-specialization">
        {% if profile.preferences.headline %}
        <div>
          <dt>職種</dt>
          <dd>{{ profile.preferences.headline }}</dd>
        </div>
        {% endif %}
        {% if profile.preferences.tagline %}
        <div>
          <dt>専門領域</dt>
          <dd>{{ profile.preferences.tagline }}</dd>
        </div>
        {% endif %}
      </dl>
      {% endif %}
    </div>
  </header>

  <section class="numbered-section">
    <h2>１．職務概要</h2>
    <p class="compact-text">{{ profile.summary }}</p>
  </section>

  {% if profile.technical_highlights %}
  <section class="numbered-section">
    <h2>２．主な実績</h2>
    <ul class="highlight-list">{% for item in profile.technical_highlights %}<li>{{ item }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  <section class="numbered-section">
    <h2>{% if profile.technical_highlights %}３{% else %}２{% endif %}．希望職種・条件</h2>
    {% if profile.preferences.desired_roles %}
    <p class="indented-line">希望職種：{{ profile.preferences.desired_roles | join("、") }}</p>
    {% endif %}
    {% if profile.preferences.desired_areas %}
    <p class="indented-line">希望領域：{{ profile.preferences.desired_areas | join("、") }}</p>
    {% endif %}
    {% if profile.preferences.relocation %}
    <p class="indented-line">就業希望：{{ profile.preferences.relocation }}</p>
    {% endif %}
    {% if profile.preferences.visa_support %}
    <p class="indented-line">在留資格：{{ profile.preferences.visa_support }}</p>
    {% endif %}
    {% if profile.preferences.work_style %}
    <p class="indented-line">志向：{{ profile.preferences.work_style }}</p>
    {% endif %}
    {% if profile.preferences.japanese_communication %}
    <p class="indented-line">語学・コミュニケーション：{{ profile.preferences.japanese_communication }}</p>
    {% endif %}
  </section>

  <section class="numbered-section{% if profile.technical_highlights %} career-section-break{% endif %}">
    <h2>{% if profile.technical_highlights %}４{% else %}３{% endif %}．職務経歴</h2>
    <table class="career-table">
      <tr><th class="career-period">期間</th><th>勤務先・業務内容</th></tr>
      {% for group in grouped_work_experience %}
      {% set group_index = loop.index0 %}
      <tr>
        <td class="career-period">{{ group.start | era_month }}<br>～<br>{% if group.end == "present" %}現在{% else %}{{ group.end | era_month }}{% endif %}</td>
        <td>
          <p class="career-company"><strong>{{ group.company }}</strong></p>
          {% for item in group.items %}
          <div class="career-role-block">
            <p class="career-role">{{ item.start | era_month }}～{% if item.end == "present" %}現在{% else %}{{ item.end | era_month }}{% endif %}：{{ item.role }}（{{ item.employment_type }}）</p>
            {% if item.overview %}<p>{{ item.overview }}</p>{% endif %}
            {% if group_index < 2 %}
            <ul>{% for responsibility in item.responsibilities[:2] %}<li>{{ responsibility }}</li>{% endfor %}</ul>
            {% if item.achievements %}
            {% set achievement_limit = 4 if group_index == 1 else 2 %}
            <p>主な成果：</p>
            <ul>{% for achievement in item.achievements[:achievement_limit] %}<li>{{ achievement }}</li>{% endfor %}</ul>
            {% endif %}
            {% if item.technologies %}<p>環境：{{ item.technologies[:8] | join("、") }}</p>{% endif %}
            {% endif %}
          </div>
          {% endfor %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </section>

  <section class="numbered-section">
    <h2>{% if profile.technical_highlights %}５{% else %}４{% endif %}．取得資格</h2>
    {% for item in profile.certifications %}
    <p class="indented-line">{{ item.date | era }}　{{ item.name }}</p>
    {% endfor %}
  </section>

  <section class="numbered-section">
    <h2>{% if profile.technical_highlights %}６{% else %}５{% endif %}．生かせる能力・スキル</h2>
    {% for group in profile.skills %}
    <p class="indented-line">・{{ group.category }}（{{ group.items | join("、") }}）</p>
    {% endfor %}
    {% for item in profile.languages %}
    <p class="indented-line">・{{ item.name }}：{{ item.level }}</p>
    {% endfor %}
  </section>

  <section class="numbered-section">
    <h2>{% if profile.technical_highlights %}７{% else %}６{% endif %}．自己ＰＲ</h2>
    <p class="compact-text">{{ profile.self_pr }}</p>
  </section>
</body>
</html>
